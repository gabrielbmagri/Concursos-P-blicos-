{
  "hosting": [
    {
      "site": "painel-de-metas",
      "public": "painel",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "template.html",
        "build.py",
        "LEIA-ME.md"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
